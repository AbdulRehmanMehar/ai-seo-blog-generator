# Postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/seo_blog
MYSQL_URL=mysql://root:password@localhost:3306/seo_blog

# Managed Postgres sometimes requires this if you don't provide a CA bundle
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# TiDB Cloud / managed MySQL often requires TLS
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Gemini
GEMINI_API_KEY=your_key_here 

# OR USE MULTIPLE KEYS SEPARATED BY COMMAS
GEMINI_API_KEYS="your_key_1,your_key_2"

# NOTE: embeddings are pinned to 768 dims to match the pgvector column. text-embedding-004
# is discontinued (404) — use gemini-embedding-001.
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Generation provider: 'gemini' (default) or 'openrouter'. With 'openrouter', text
# GENERATION goes to OpenRouter (e.g. DeepSeek) — escaping Gemini's free-tier 20/day cap.
# EMBEDDINGS always stay on Gemini (OpenRouter has no embeddings), so keep GEMINI_API_KEYS set.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Scheduler (cron)
CRON_SCHEDULE_1=15 9 * * *
CRON_SCHEDULE_2=15 17 * * *

# Safety caps
LLM_MIN_SECONDS_BETWEEN_REQUESTS=10
LLM_DAILY_REQUEST_CAP=20

# Posts to generate per pipeline run
# With 1 key: 2-3 posts, with 3 keys: 6-8 posts
POSTS_PER_RUN=2

# Keyword discovery is GSC-first: import proven-demand near-miss queries first; only expand
# via SERP providers when the unused-keyword pool falls below this target.
KEYWORD_POOL_TARGET=15

# Pause NEW article generation but keep the GSC/GA4 review + refresh/optimization loop
# running (sync, opportunity detection, CTR/decline/engagement refreshes). Set true to
# freeze new posts for a while; flip back to false to resume.
PAUSE_NEW_POSTS=false

# Generation controls
POST_MIN_WORDS=1200
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# Target reading level (CEFR). A2 = elementary: short sentences, simple words, no em dashes.
# Enforced via prompts + deterministic humanizer pass + a review check. Set 'none' to disable.
CONTENT_READING_LEVEL=A2
# Sentences longer than this many words are flagged as too complex during review.
READING_MAX_SENTENCE_WORDS=22

# Indexing mechanics
# How a post's public URL is built. Placeholders: {domain} and {slug}.
BLOG_URL_PATTERN="https://{domain}/blog/{slug}"
# Where sitemap-<domain>.xml (and the IndexNow key file) are written. Defaults to EXPORT_DIR.
SITEMAP_DIR="./out/posts"
# IndexNow key (8-128 hex chars). When set, new/updated URLs are submitted to
# IndexNow (Bing/Yandex/Seznam — NOT Google). Host <key>.txt at each domain root.
INDEXNOW_KEY=""
# Submit URLs published/updated within this many days each run.
INDEXING_LOOKBACK_DAYS=2

# Taxonomy (categories + tags) hub pages
CATEGORY_URL_PATTERN="https://{domain}/blog/category/{slug}"
TAG_URL_PATTERN="https://{domain}/blog/tag/{slug}"
# A tag page becomes indexable / enters the sitemap only at this many published posts.
TAG_INDEX_MIN_POSTS=3
# Max category/tag hub pages to (re)generate unique content for per run (LLM cost cap).
TAXONOMY_PAGE_CONTENT_PER_RUN=3

# ── Google (GSC + GA4) auth ───────────────────────────────────────────────
# PREFERRED: a service account (headless, never expires). Use ONE of these two.
# (A) Local dev — path to the downloaded JSON key file:
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# (B) Docker/Portainer — paste the WHOLE JSON key as a single line, single-quoted:
# GSC_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"name@project.iam.gserviceaccount.com", ...}'
#
# The service-account email must be added as an Owner on each GSC property and a
# Viewer on each GA4 property, and the Search Console API + Analytics Data API must
# be enabled on the project.
#
# Legacy OAuth fallback (only used if no service account is configured):
# GSC_CLIENT_ID / GSC_CLIENT_SECRET / GSC_REFRESH_TOKEN / GSC_ACCESS_TOKEN / GSC_TOKEN_EXPIRY

# SERP STACK APIs - Multiple APIs separated by commas
SERPSTACK_APIS=""

# ZENSERP_APIS APIs - Multiple APIs separated by commas
ZENSERP_APIS=""

# SCRAPPER_X_API - Single API key
SCRAPPER_X_API=""

# Maximum limits for SERPSTACK and ZENSERP
SERPSTACK_MAX_LIMIT=100
ZENSERP_MAX_LIMIT=50

# GitHub Personal Access Token
GITHUB_PAT=""

# Max repos to fetch for knowledge sync (default: 100, set 0 for unlimited)
GITHUB_MAX_REPOS=100

# Knowledge sync cron (default: daily at 3 AM)
CRON_KNOWLEDGE_SYNC="0 3 * * *"